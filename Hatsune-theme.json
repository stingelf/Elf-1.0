{
  "name": "Hatsune Theme",
  "variant": "light",
  "version": "1.0.0",
  "author": "stingelf",
  "colors": {
    "background": "#f7f7ff",
    "primary": "#6f42c1",
    "secondary": "#00a3e0",
    "accent": "#ff66cc",
    "text": "#212121",
    "muted": "#6b7280"
  },
  "font": {
    "family": "Noto Sans, 'Segoe UI', Roboto, sans-serif",
    "size": "14px"
  },
  "icons": {
    "enabled": true,
    "style": "rounded"
  },
  "syntax": {
    "keyword": "#6f42c1",
    "string": "#ff66cc",
    "number": "#00a3e0",
    "comment": "#9ca3af"
  },
  "backgroundImage": {
    "url": "https://example.com/hatsune-bg.png",
    "opacity": 0.08,
    "position": "center",
    "repeat": "no-repeat",
    "size": "cover"
  },
  "settings": {
    "showStatusBar": true,
    "roundedCorners": true
  },
  "description": "A soft pastel theme inspired by Hatsune Miku / Vocaloid aesthetics.",
  "license": "MIT"
}
